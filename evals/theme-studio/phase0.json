    {
      "id": "vertical-indian-jewelry",
      "category": "vertical_quality",
      "prompt": "Design a refined Indian jewelry theme with strong detail photography, material education and gifting discovery.",
      "referenceNotes": [],
      "expectedOutcome": "candidate",
      "checks": [
