{
  "version": 1,
  "description": "Phase 0 golden briefs for Mink AI Theme Studio. These are contracts for intent extraction and package evaluation, not provider scores yet.",
  "cases": [
    {
      "id": "vertical-fashion-editorial",
      "category": "vertical_quality",
      "prompt": "Create a monochrome editorial theme for an independent footwear label. Product photography and sizing must dominate decoration.",
      "referenceNotes": [],
      "expectedOutcome": "candidate",
      "checks": [
        "clothing or shoes intent",
        "complete home/shop/product/cart composition",
        "mobile product discovery"
      ],
      "forbidden": ["copied luxury-brand copy", "generic recolor only"]
    },
    {
      "id": "vertical-grocery-dense",
      "category": "vertical_quality",
      "prompt": "Build a fast grocery theme for a 500-item catalogue with category-first navigation, search and quick add.",
      "referenceNotes": [],
      "expectedOutcome": "candidate",
      "checks": [
        "dense but readable intent",
        "large-catalogue behavior",
        "variant-safe quick add"
      ],
      "forbidden": ["editorial one-product layout", "silent variant choice"]
    },
    {
      "id": "vertical-skincare-routine",
      "category": "vertical_quality",
      "prompt": "Design a premium botanical skincare theme organized around routines and ingredient education.",
      "referenceNotes": [],
